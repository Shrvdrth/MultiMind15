ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=multimind;Username=postgres;Password=yourpassword
Jwt__Key=REPLACE_WITH_A_STRONG_SECRET_KEY_MIN_32_CHARS
Jwt__Issuer=MultiMind
Jwt__Audience=MultiMindUsers
Jwt__ExpiryMinutes=60
OpenAI__ApiKey=sk-or-REPLACE_WITH_YOUR_OPENROUTER_KEY
OpenAI__Model=openrouter/free
OpenAI__BaseUrl=https://openrouter.ai/api/v1
# CORS: frontend URL(s), comma-separated, no trailing slash
Frontend__Url=http://localhost:5173
# Only this account becomes Admin
Admin__Email=you@example.com
# Daily free-tier limits (rolling 24 hours)
UsageLimits__DebatesPerUserPerDay=2
UsageLimits__DebatesPerSitePerDay=6
UsageLimits__ChatMessagesPerUserPerDay=5
UsageLimits__ChatMessagesPerSitePerDay=8
