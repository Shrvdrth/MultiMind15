# Copy this file to .env and fill in real values before running docker compose up

# PostgreSQL
DB_PASSWORD=changeme

# JWT — use a random string of at least 32 characters
JWT_KEY=REPLACE_WITH_A_STRONG_SECRET_KEY_MIN_32_CHARS

# OpenRouter API key  (https://openrouter.ai/keys)
OPENAI_API_KEY=sk-or-REPLACE_WITH_YOUR_OPENROUTER_KEY
OPENAI_MODEL=anthropic/claude-3.5-sonnet
OPENAI_BASE_URL=https://openrouter.ai/api/v1
