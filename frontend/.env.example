# Backend API base URL (read at build time). On Vercel set it to
# https://<your-render-app>.onrender.com/api and redeploy after changes.
VITE_API_BASE_URL=http://localhost:5125/api

# Optional: where the "watch the demo" link points when a daily limit is hit.
# Defaults to /MultiMind-Demo.html served from public/.
# VITE_DEMO_URL=/MultiMind-Demo.html
